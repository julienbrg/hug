{
  "includeCoAuthoredBy": false,
  "gitAttribution": false,
  "extraKnownMarketplaces": {
    "hug": {
      "source": { "source": "github", "repo": "julienbrg/hug" }
    }
  },
  "enabledPlugins": {
    "hug@hug": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/forge-context.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./secrets/**)",
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git add .)",
      "Bash(git commit -a *)",
      "Bash(git commit --all *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(gh pr merge * --admin*)"
    ]
  }
}
